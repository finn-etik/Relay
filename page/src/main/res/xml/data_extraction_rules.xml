<?xml version="1.0" encoding="utf-8"?>
<!-- The sync settings hold the Drime access token: never part of a backup or a device transfer. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="page_sync.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="page_sync.xml" />
    </device-transfer>
</data-extraction-rules>
